[configuration]
entry_symbol = "onnx_loader_library_init"
compatibility_minimum = "4.6"

[libraries]
windows.debug.x86_64 = "./bin/libonnx_loader.windows.template_debug.x86_64.dll"
android.debug.arm64 = "./bin/libonnx_loader.android.template_debug.arm64.so"
android.release.arm64 = "./bin/libonnx_loader.android.template_release.arm64.so"

[dependencies]
android.debug.arm64 = {
    "./bin/libonnxruntime.so": ""
}
android.release.arm64 = {
    "./bin/libonnxruntime.so": ""
}
